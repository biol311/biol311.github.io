@incollection{soaresExtremeMarginalCoral2026,
  title = {Extreme and {{Marginal Coral Reefs}} and {{Communities}}: {{A Global Synthesis}}},
  booktitle = {Extreme and {{Marginal Coral Reefs}} and {{Communities}}: {{Living}} at the {{Edge}} of {{Environmental Limits}}},
  author = {Soares, Marcelo O. and Smith, Tyler B. and Camp, Emma F. and Schoepf, Verena and Gurgel, Anne L. and Oliveira, Mariany and Siqueira, Alexandre C. and Morais, Juliano and Longo, Guilherme O. and Bender, Mariana and Santos, Br{\'a}ulio A. and Bleuel, Jessica and Rabelo, Emanuelle F.},
  editor = {Soares, Marcelo O. and Smith, Tyler B. and Camp, Emma F. and Schoepf, Verena},
  year = 2026,
  pages = {1--15},
  publisher = {Springer Nature Switzerland},
  address = {Cham},
  doi = {10.1007/978-3-032-28035-0_1},
  abstract = {Corals are foundation organisms that thrive in a wide range of environmental conditions. While much of the research on tropical coral reefs has focused on areas conducive to carbonate growth, such as clear, low-nutrient, shallow waters, there is a significant gap in studying coral communities and reefs that thrive at the edge of their environmental limits. Recent theoretical advancements have provided a novel framework for studying these extreme and marginal reefs, re-defining coral reef extremeness and marginality and providing a broader perspective on their ecological significance. Extreme coral environments are characterised by large deviations from optimal abiotic conditions, with extreme in this case meaning: elevated siliciclastic sedimentation, turbid waters, high nutrient levels (e.g., nitrogen and phosphorus), substantial depths, and fluctuating or extreme temperature, pH, salinity, and dissolved oxygen conditions. In some cases, but certainly not all, these extreme conditions can lead to altered coral cover, community composition, and ecosystem functioning characteristic of marginal reefs and coral communities. Thus, areas with extreme environmental conditions are often mistakenly considered unsuitable for sustaining biogenic growth and biodiversity. However, extreme environments may serve as refugia and natural laboratories in the face of ongoing climate change, and can potentially offer insights into how coral ecosystems might respond to future oceanic conditions. This chapter serves as a comprehensive introduction to the global study of extreme and marginal reef environments, consolidating the knowledge accumulated to date. It provides an overview of the unique coral communities found in extreme conditions, such as those in the hottest waters, turbid-zone reefs, intertidal zones, low pH areas around submarine springs and CO2 vents, regions affected by upwelling and internal waves, as well as seagrass and mangrove-coral ecosystems, semi-enclosed bays, mesophotic reefs, and high-latitude reefs. Given the increasing impacts of climate change and human activities on global coral reefs, research into these important habitats offers critical insights for conservation and the future resilience of marine ecosystems.},
  isbn = {978-3-032-28035-0}
}

@article{roosDriversAbundanceBiomass2019,
  title = {Drivers of Abundance and Biomass of {{Brazilian}} Parrotfishes},
  author = {Roos, Natalia C. and Pennino, Maria G. and Carvalho, Adriana R. and Longo, Guilherme O.},
  year = 2019,
  journal = {Marine Ecology Progress Series},
  volume = {623},
  eprint = {26789877},
  eprinttype = {jstor},
  pages = {117--130},
  publisher = {Inter-Research Science Center},
  issn = {0171-8630},
  urldate = {2026-10-13},
  abstract = {Parrotfishes may affect the structure of benthic communities and reef ecosystem functioning. Despite extensive studies worldwide, parrotfishes in the southwestern Atlantic are relatively understudied, limiting our ability to propose effective management strategies. We assessed abundance, biomass and size class distribution of parrotfish assemblages in northeastern Brazil and identified habitat preferences based on reef attributes. Outer-shelf reefs sustained larger individuals and higher biomasses for all species (except Sparisoma radians). In contrast, inner-shelf reefs supported higher abundances of small individuals. Even though most species occurred across all areas, their abundances, biomass and size-class distributions were variable and related to their respective feeding modes and reef attributes. Benthic cover, reef structural complexity, depth and distance from the coast affected the composition of parrotfish assemblages, but had different effects on each species. The endemic greenbeak parrotfish Scarus trispinosus was more abundant on calcareous substrates and higher-complexity reefs. Sc. zelindae and Sp. amplum were more common in deeper biogenic reefs further from the coast, which were characterized by high abundances of sponges, stony corals and cyanobacterial mats. Sp. axillare and Sp. radians were more abundant on reefs that had high cover of large-bladed macroalgae, while Sp. frondosum was ubiquitous across all studied reefs. Such heterogeneity in habitat use is suggestive of functional complementarity rather than functional redundancy among parrotfish assemblages. Conservation of Brazilian endemic parrotfishes requires protecting reefs with diverse attributes and a better understanding of habitat connectivity and the role of different habitats in parrotfish reproduction and life cycle.}
}

@article{teichertPossibleLinkCoral2020,
  title = {A Possible Link between Coral Reef Success, Crustose Coralline Algae and the Evolution of Herbivory},
  author = {Teichert, Sebastian and Steinbauer, Manuel and Kiessling, Wolfgang},
  year = 2020,
  month = oct,
  journal = {Scientific Reports},
  volume = {10},
  number = {1},
  pages = {17748},
  publisher = {Nature Publishing Group},
  issn = {2045-2322},
  doi = {10.1038/s41598-020-73900-9},
  urldate = {2024-11-29},
  abstract = {Crustose coralline red algae (CCA) play a key role in the consolidation of many modern tropical coral reefs. It is unclear, however, if their function as reef consolidators was equally pronounced in the geological past. Using a comprehensive database on ancient reefs, we show a strong correlation between the presence of CCA and the formation of true coral reefs throughout the last 150~Ma. We investigated if repeated breakdowns in the potential capacity of CCA to spur reef development were associated with sea level, ocean temperature, CO2 concentration, CCA species diversity, and/or the evolution of major herbivore groups. Model results show that the correlation between the occurrence of CCA and the development of true coral reefs increased with CCA diversity and cooler ocean temperatures while the diversification of herbivores had a transient negative effect. The evolution of novel herbivore groups compromised the interaction between CCA and true reef growth at least three times in the investigated time interval. These crises have been overcome by morphological adaptations of CCA.},
  copyright = {2020 The Author(s)},
  langid = {english},
  keywords = {Ecology,Evolution,Ocean sciences},
  file = {/Users/jarrett.byrnes/Zotero/storage/PTV25MZM/Teichert et al. - 2020 - A possible link between coral reef success, crustose coralline algae and the evolution of herbivory.pdf}
}

@article{silbigerNutrientPollutionDisrupts2018,
  title = {Nutrient Pollution Disrupts Key Ecosystem Functions on Coral Reefs},
  author = {Silbiger, Nyssa J. and Nelson, Craig E. and Remple, Kristina and Sevilla, Jessica K. and Quinlan, Zachary A. and Putnam, Hollie M. and Fox, Michael D. and Donahue, Megan J.},
  year = 2018,
  month = jun,
  journal = {Proceedings of the Royal Society B: Biological Sciences},
  volume = {285},
  number = {1880},
  pages = {20172718},
  publisher = {Royal Society},
  doi = {10.1098/rspb.2017.2718},
  urldate = {2024-11-29},
  abstract = {There is a long history of examining the impacts of nutrient pollution and pH on coral reefs. However, little is known about how these two stressors interact and influence coral reef ecosystem functioning. Using a six-week nutrient addition experiment, we measured the impact of elevated nitrate (NO-3) and phosphate (PO3-4) on net community calcification (NCC) and net community production (NCP) rates of individual taxa and combined reef communities. Our study had four major outcomes: (i) NCC rates declined in response to nutrient addition in all substrate types, (ii) the mixed community switched from net calcification to net dissolution under medium and high nutrient conditions, (iii) nutrients augmented pH variability through modified photosynthesis and respiration rates, and (iv) nutrients disrupted the relationship between NCC and aragonite saturation state documented in ambient conditions. These results indicate that the negative effect of NO-3 and PO3-4 addition on reef calcification is likely both a direct physiological response to nutrients and also an indirect response to a shifting pH environment from altered NCP rates. Here, we show that nutrient pollution could make reefs more vulnerable to global changes associated with ocean acidification and accelerate the predicted shift from net accretion to net erosion.},
  keywords = {biological feedbacks,coral reefs,nutrient pollution,pH},
  file = {/Users/jarrett.byrnes/Zotero/storage/HLFTBT2W/Silbiger et al. - 2018 - Nutrient pollution disrupts key ecosystem functions on coral reefs.pdf}
}

@article{knowltonThresholdsMultipleStable1992,
  title = {Thresholds and {{Multiple Stable States}} in {{Coral Reef Community Dynamics}}},
  author = {Knowlton, Nancy},
  year = 1992,
  journal = {American Zoologist},
  volume = {32},
  number = {6},
  pages = {674--682},
  doi = {10.1093/icb/32.6.674},
  abstract = {Multiple stable states occur when more than one type of community can stably persist in a single environmental regime. Simple theoretical analyses predict multiple stable states for (1) single species dynamics via the Allee effect, (2) two-species competitive interactions characterized by unstable coexistence, (3) some predator-prey interactions, and (4) some systems combining predation and competition. Potential examples of transitions between stable states on reefs include the failure of Diadema antillarum and Acropora cervicornis to recover following catastrophic mortality, and the replacement of microalgal turf by unpalatable macroalgae after rapid increase in the amount of substratum available for colonization by algae. Subtidal marine ecosystems in general, and reefs in particular, have several attributes which favor the existence of multiple stable states. Studies of transitions between states often need to rely upon poorly controlled, unreplicated natural ``experiments,'' as transitions typically require pulses of disturbance over very large spatial scales. The stability of a state must often be inferred from analyses of the dynamics of participants at that state, as generation times and the potential for further extrinsic disturbance preclude the use of persistence as an indicator of stability. The potential for multiple stable states strongly influences our interpretation of variability in space and time and our ability to predict reef responses to natural and man-made environmental change.}
}

